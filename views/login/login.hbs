<div class="text-center">
    <img src="/resources/logo.png" alt="Logo ComplyHub" class="logo" style="max-width:320px"/>
</div>


        {{#if error}}
        <div class="error alert alert-danger text-center mt-5" role="alert">
            {{error}}
        </div>
        {{/if}}


<div class="container my-2">
	<div class="row justify-content-center">
		<div class="col-md-6 col-lg-4">
			<div class="card shadow">
				<div class="card-body">
                    <h1 class="text-center mb-4 brand-name">Comply<span class="brand-accent">Hub</span></h1>
					{{!-- <h2 class="card-title text-center mb-4">Είσοδος</h2> --}}
					<form action="/login" method="POST" autocomplete="off">
                        <wa-input class="my-3" label="E-mail" name="email" required></wa-input>
                        <wa-input class="my-3" label="Κωδικός πρόσβασης" type="password" name="password" password-toggle required></wa-input>
						<div class="mt-4 text-end">
                            <wa-button variant="brand" type="submit" >Είσοδος </wa-button>
                        </div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>