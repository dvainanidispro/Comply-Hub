<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h1 class="card-title h3">
                        <i class="bi bi-folder2-open me-2"></i>
                        Διαχείριση Αρχείων
                    </h1>
                </div>
                <div class="card-body" x-data="storageBrowser()">

                    {{!-- Toolbar: κουμπί Πάνω + breadcrumb --}}
                    <div class="d-flex align-items-center g-3 mb-3">
                        <button x-show="browsing" @click="goUp()" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-arrow-up me-1"></i>Πάνω
                        </button>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item" :class="!currentPath ? 'active' : ''">
                                    <span :class="currentPath ? 'hand' : ''" @click="currentPath && goToPath('')">Storage</span>
                                </li>
                                <template x-for="(part, index) in breadcrumbs" :key="index">
                                    <li class="breadcrumb-item" :class="index === breadcrumbs.length - 1 ? 'active' : ''">
                                        <span
                                            :class="index < breadcrumbs.length - 1 ? 'hand' : ''"
                                            x-text="part"
                                            @click="index < breadcrumbs.length - 1 && goToBreadcrumb(index)"
                                        ></span>
                                    </li>
                                </template>
                            </ol>
                        </nav>
                    </div>

                    {{!-- Αρχική προβολή: μόνο ο φάκελος Storage --}}
                    <template x-if="!browsing">
                        <div class="list-group">
                            <div class="list-group-item list-group-item-action d-flex align-items-center gap-2 hand" @click="goToPath('')">
                                <i class="bi bi-folder-fill text-warning fs-5"></i>
                                <span>Storage</span>
                            </div>
                        </div>
                    </template>

                    {{!-- Προβολή περιεχομένων φακέλου --}}
                    <template x-if="browsing">
                        <div>
                            <div x-show="loading" class="text-muted py-2">
                                <i class="bi bi-hourglass-split me-1"></i>Φόρτωση...
                            </div>
                            <div x-show="!loading" class="list-group">
                                <div x-show="items.folders.length === 0 && items.files.length === 0" class="list-group-item text-muted fst-italic">
                                    Ο φάκελος είναι άδειος.
                                </div>
                                <template x-for="folder in items.folders" :key="folder.path">
                                    <div class="list-group-item list-group-item-action d-flex align-items-center gap-2 hand storage-item" @click="goToPath(folder.path)">
                                        <i class="bi bi-folder-fill text-warning fs-5"></i>
                                        <span x-text="folder.name"></span>
                                        <button class="delete-icon ms-auto btn btn-outline-danger py-0" @click.stop="deleteItem(folder, true)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </template>
                                <template x-for="file in items.files" :key="file.path">
                                    <div class="list-group-item list-group-item-action d-flex align-items-center gap-2 hand storage-item" @click="downloadFile(file)">
                                        <i class="bi bi-file-earmark fs-5 text-secondary"></i>
                                        <span class="flex-grow-1" x-text="file.name"></span>
                                        <button class="delete-icon btn btn-outline-danger py-0" @click.stop="deleteItem(file, false)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <span class="text-muted small" x-text="formatSize(file.size)"></span>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
function storageBrowser() {
    return {
        browsing: false,
        currentPath: '',
        items: { folders: [], files: [] },
        loading: false,

        get breadcrumbs() {
            if (!this.currentPath) return [];
            return this.currentPath.split('/');
        },

        async goToPath(folderPath) {
            this.loading = true;
            this.browsing = true;
            const result = await Q.fetch(`/admin/storage/list?path=${encodeURIComponent(folderPath)}`);
            if (result?.success) {
                this.currentPath = folderPath;
                this.items = { folders: result.folders, files: result.files };
            }
            this.loading = false;
        },

        goUp() {
            if (!this.currentPath) {
                this.browsing = false;
                return;
            }
            const parts = this.currentPath.split('/');
            parts.pop();
            this.goToPath(parts.join('/'));
        },

        goToBreadcrumb(index) {
            const parts = this.currentPath.split('/').slice(0, index + 1);
            this.goToPath(parts.join('/'));
        },

        formatSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        },

        async downloadFile(file) {
            const confirmed = await Q.confirm(`Λήψη αρχείου "${file.name}";`, 'Λήψη', 'Άκυρο');
            if (!confirmed) return;
            const a = document.createElement('a');
            a.href = `/admin/storage/download?path=${encodeURIComponent(file.path)}`;
            a.download = file.name;
            a.click();
        },

        async deleteItem(item, isFolder) {
            const type = isFolder ? `φακέλου` : 'αρχείου';
            const confirmed = await Q.confirm(`Διαγραφή ${type} "${item.name}" ${isFolder ? 'με όλα τα περιεχόμενά του' : ''}; Η διαγραφή δεν μπορεί να αντιστραφεί!`, 'Διαγραφή', 'Άκυρο');
            if (!confirmed) return;
            const result = await Q.fetch.delete('/admin/storage/delete', { path: item.path });
            if (result?.success) {
                await this.goToPath(this.currentPath);
                Q.alert('Η διαγραφή ολοκληρώθηκε επιτυχώς.', 'OK');
            } else {
                Q.alert('Η διαγραφή απέτυχε.', 'OK');
            }
        },
    };
}
</script>
