<script>
    window.kpis = {{{objectify kpis}}};
    console.debug('kpis:');
    console.debug(window.kpis);
</script>



<div class="row g-4 mt-2">

    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">       
                <h1 class="mb-0 fw-semibold h3"><i class="bi bi-bar-chart me-2"></i>{{title}}</h1>
            </div>
            <div class="card-body">
                <wa-tab-group>
                    <wa-tab panel="pending" >Εκκρεμή</wa-tab>
                    <wa-tab panel="current" {{#unless pendingKpis.length}}active{{/unless}}>Τρέχοντα</wa-tab>
                    <wa-tab panel="past">Όλα</wa-tab>

                    <wa-tab-panel name="pending">
                        {{#if pendingKpis.length}}
                        <wa-callout variant="warning">
                            <wa-icon slot="icon" name="triangle-exclamation"></wa-icon>
                            <strong>Σε εκρεμμότητα: {{inflect pendingKpis.length 'KPI' 'KPIs'}}</strong><br />
                            Παρακαλώ, συμπληρώστε τα εκκρεμή KPIs κάνοντας κλικ πάνω τους.
                        </wa-callout>
                        {{else}}
                        <wa-callout variant="success">
                            <wa-icon slot="icon" name="check-circle"></wa-icon>
                            <strong>Δεν υπάρχουν εκκρεμή KPIs</strong><br />
                            Όλα τα KPIs έχουν συμπληρωθεί.
                        </wa-callout>
                        {{/if}}
                        {{> kpi/table kpis=pendingKpis links=true section="pending" }}
                    </wa-tab-panel>
                    <wa-tab-panel name="current" >
                        {{> kpi/grid kpis=kpis links=true section="current" }}
                    </wa-tab-panel>
                    <wa-tab-panel name="past">
                        {{> kpi/table kpis=null links=true section="past" init="kpis=await Q.fetch(window.location.pathname+'/json/all')"}}
                        {{!-- <bootstrap-spinner class="my-4"></bootstrap-spinner> --}}
                    </wa-tab-panel>
                </wa-tab-group>

            </div>
        </div>
    </div>

</div>

{{> kpi/dialog kpis=kpis }}




<style>
    :root {
        --wa-tooltip-background-color: hsl(242, 36%, 42%);
    }
</style>
<script>
    window.dimtablesOptions = {
        pageInfoTemplate:' '
    }
</script>