

<div class="row g-4 mt-2">

    {{!-- ===== ΣΧΕΔΙΟ 1: Compact Table ===== --}}
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-table"></i>
                <h5 class="mb-0 fw-semibold">Σχέδιο 1 — Πίνακας</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Κωδικός</th>
                            <th>Δείκτης</th>
                            <th>Περίοδος</th>
                            <th class="text-end">Τιμή</th>
                            <th class="text-end">Στόχος</th>
                            <th class="text-center">Κατάσταση</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each result}}
                        <tr>
                            <td><code>{{code}}</code></td>
                            <td>{{template.name}}</td>
                            <td><span class="badge bg-secondary">{{period}}</span></td>
                            <td class="text-end fw-semibold text-{{status}}">
                                {{#if value}}{{value}}{{label 'unit' template.unit}}{{else}}&mdash;{{/if}}
                            </td>
                            <td class="text-end text-muted">{{template.successRule.criteria}}{{label 'unit' template.unit}}</td>
                            <td class="text-center">
                                {{#if (eq status 'warning')}}
                                    <span class="badge bg-warning text-dark">Εκκρεμεί</span>
                                {{else}}
                                    <span class="badge bg-{{status}}">{{#if success}}Επιτυχής{{else}}Αποτυχία{{/if}}</span>
                                {{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{!-- ===== ΣΧΕΔΙΟ 2: Metric Cards Grid ===== --}}
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-grid-3x3-gap"></i>
                <h5 class="mb-0 fw-semibold">Σχέδιο 2 — Metric Cards</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{#each result}}
                    <div class="col-md-3 col-sm-6">
                        <div class="card h-100 border border-2 border-{{status}}">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-light text-dark border small">{{period}}</span>
                                    <code class="small text-muted">{{code}}</code>
                                </div>
                                <div class="text-center my-auto py-2">
                                    <div class="display-5 fw-bold text-{{status}}">
                                        {{#if value}}{{value}}{{else}}&mdash;{{/if}}
                                    </div>
                                    <div class="small text-muted">{{label 'unit' template.unit}}</div>
                                </div>
                                <div class="mt-auto pt-2 border-top">
                                    <div class="small fw-semibold text-wrap" title="{{template.name}}">{{template.name}}</div>
                                    <div class="small text-muted">Στόχος: <strong>{{template.successRule.criteria}}</strong> {{label 'unit' template.unit}}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>

    {{!-- ===== ΣΧΕΔΙΟ 3: List με οπτικούς δείκτες ===== --}}
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-list-ul"></i>
                <h5 class="mb-0 fw-semibold">Σχέδιο 3 — List με δείκτες</h5>
            </div>
            <div class="list-group list-group-flush">
                {{#each result}}
                <div class="list-group-item list-group-item-action px-4 py-3 kpi-status-{{status}}">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <div class="fw-semibold">{{template.name}}</div>
                                <div class="small text-muted mt-1">
                                    <code>{{code}}</code>
                                    <span class="mx-1">·</span>
                                    <span>{{template.frequency}}</span>
                                    <span class="mx-1">·</span>
                                    <span>Υπεύθυνος: {{template.responsible}}</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-4 text-end">
                            <div>
                                <div class="small text-muted">Περίοδος</div>
                                <span class="badge bg-secondary">{{period}}</span>
                            </div>
                            <div style="min-width: 80px;">
                                <div class="small text-muted">Τιμή / Στόχος</div>
                                <span class="fw-semibold text-{{status}}">
                                    {{#if value}}{{value}}{{else}}&mdash;{{/if}}
                                </span>
                                <span class="text-muted"> / {{template.thresholdTarget}} {{template.unit}}</span>
                            </div>
                            <div>
                                {{#if (eq status 'warning')}}
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Εκκρεμεί</span>
                                {{else}}
                                    <span class="badge bg-{{status}}"><i class="bi bi-{{#if success}}check-lg{{else}}x-lg{{/if}}"></i> {{#if success}}Επιτυχής{{else}}Αποτυχία{{/if}}</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>

</div>

<script>
    window.result = {{{objectify result}}};
    console.log('result:');
    console.log(window.result);
</script>