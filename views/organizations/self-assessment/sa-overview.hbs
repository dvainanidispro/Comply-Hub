                            </template>
                        </li>
                    </template>
                </ul>
                 --}}

                <a href="{{formUrl}}" class="btn btn-icon btn-primary">
                    <bootstrap-icon icon="pencil-fill"></bootstrap-icon>
                    <div>Είσοδος στη φόρμα αυτοαξιολόγησης</div>
                </a>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Αποτελέσματα</div>
            <div class="card-body">
                <!-- TODO: αποτελέσματα αυτοαξιολόγησης -->
                <p>Εδώ θα εμφανίζονται τα αποτελέσματα της αυτοαξιολόγησης (Dashboard).</p>
