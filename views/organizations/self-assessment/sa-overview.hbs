<script>
    /* Raw δεδομένα (JSONB-ready) του ερωτηματολογίου/response — μέσω objectify.
     * Χρησιμοποιούνται μόνο για να βγει η "Κατάσταση αυτοαξιολόγησης" (response.status)
     * με την ίδια κοινή factory questionnaireForm() που χρησιμοποιεί και η sa-form. */
    window.questionnaireRecord = {{{objectify questionnaire}}};
    window.responseData = {{{objectify (check response response.data null)}}};
</script>

<div class="row g-4 mt-2" x-data="questionnaireForm(window.questionnaireRecord, window.responseData)" x-cloak>

    <div class="col-lg-10">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center g-2">
                <h1 class="card-title h3 mb-0">{{title}}</h1>
                {{#if response}}
                <span class="badge bg-{{label 'statusColor' response.status}}">{{label 'status' response.status}}</span>
                {{#if response.approvedAt}}<span class="badge bg-success">{{label 'status' 'approved'}}</span>{{/if}}
                {{/if}}
            </div>
            <div class="card-body">
                <p class="text-muted" x-text="questionnaire.description"></p>

{{!-- 
                <h2 class="h6">Κατάσταση αυτοαξιολόγησης</h2>
