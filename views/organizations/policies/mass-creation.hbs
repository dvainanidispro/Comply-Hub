<div class="container-fluid">
    <div class="row">
        <div class="col-12 mb-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{baseUrl}}">{{section}}</a></li>
                    <li class="breadcrumb-item active">Μαζική Δημιουργία</li>
                </ol>
            </nav>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="bi bi-files me-2"></i>
                        <span>{{section}} - Μαζική Δημιουργία</span>
                    </h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">Επιλέξτε τις {{displayType.pluralLower}} που θέλετε να δημιουργήσετε για τον οργανισμό. Οι {{displayType.pluralLower}} που έχουν ήδη δημιουργηθεί εμφανίζονται ως ανενεργές.</p>
                    <form id="massCreationForm">
                        {{#each policyTypes}}
                        <div class="form-check mb-2">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="policyTypeIds"
                                value="{{this.id}}"
                                id="pt_{{this.id}}"
                                {{#if this.default}}checked{{/if}}
                                {{#if this.assigned}}disabled checked{{/if}}
                            >
                            <label class="form-check-label {{#if this.assigned}}text-muted{{/if}}" for="pt_{{this.id}}">
                                {{#if this.code}}<span class="badge bg-secondary me-1">{{this.code}}</span>{{/if}}
                                {{this.name}}
                                {{#if this.assigned}}<span class="badge bg-success ms-1">Υπάρχει ήδη</span>{{/if}}
                            </label>
                        </div>
                        {{/each}}

                        <div class="d-flex g-2 mt-4">
                            <button type="submit" class="btn btn-success btn-icon">
                                <bootstrap-icon icon="check-circle-fill"></bootstrap-icon>
                                <div>Δημιουργία Επιλεγμένων</div>
                            </button>
                            <a href="{{baseUrl}}" class="btn btn-secondary btn-icon">
                                <bootstrap-icon icon="x-circle-fill"></bootstrap-icon>
                                <div>Ακύρωση</div>
                            </a>
                            <bootstrap-spinner class="d-none"></bootstrap-spinner>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module">
const baseUrl = '{{baseUrl}}';

Q('#massCreationForm').on('submit', async function(e) {
    Q("#modalSuccessTitle").set("Μαζική Δημιουργία");
    e.preventDefault();
    const checked = [...Q('input[name="policyTypeIds"]:checked')].map(el => el.value);
    await submitData({ policyTypeIds: checked }, `${baseUrl}/mass-creation`, 'POST', baseUrl);
});
</script>
