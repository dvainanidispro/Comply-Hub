<div class="container-fluid">
    <div class="row">
        <div class="col-12 mb-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{baseUrl}}">{{section}}</a></li>
                    <li class="breadcrumb-item active">{{#if (eq mode 'create')}}Νέα {{displayType.singular}}{{else}}{{policy.name}}{{/if}}</li>
                </ol>
            </nav>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        {{#if (eq mode 'create')}}
                        <i class="bi bi-plus-circle me-2"></i>
                        <span>{{framework}} - Νέα {{displayType.singular}}</span>
                        {{else}}
                        <i class="bi bi-file-earmark-text me-2"></i>
                        <span>{{framework}} - {{policy.name}}</span>
                        {{/if}}
                    </h4>
                </div>
                <div class="card-body">
                    <form id="form">
                        {{#unless (eq mode 'create')}}
                        <input type="hidden" name="id" value="{{policy.id}}">
                        {{/unless}}

                        {{#if (eq mode 'create')}}
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="policyTypeId" class="form-label fw-bold">Πρότυπο <req-star></req-star></label>
                                <select class="form-select" id="policyTypeId" name="policyTypeId">
                                    <option value="">— Προσαρμοσμένη {{displayType.singular}} —</option>
                                    {{#each availablePolicyTypes}}
                                    <option value="{{this.id}}">{{#if this.code}}[{{this.code}}] {{/if}}{{this.name}}</option>
                                    {{/each}}
                                </select>
                                <div class="form-text">Αν επιλέξετε πρότυπο, τα πεδία συμπληρώνονται αυτόματα. Αφήστε κενό για προσαρμοσμένη {{displayType.singularLower}}.</div>
                            </div>
                        </div>
                        {{/if}}

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label for="name" class="form-label fw-bold">Όνομα <req-star></req-star></label>
                                <input type="text" class="form-control" id="name" name="name" value="{{policy.name}}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="code" class="form-label fw-bold">Κωδικός <req-star></req-star></label>
                                <input type="text" class="form-control" id="code" name="code" value="{{policy.code}}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="version" class="form-label fw-bold">Έκδοση</label>
                                <input type="text" class="form-control" id="version" name="version" value="{{policy.version}}">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="description" class="form-label fw-bold">Περιγραφή</label>
                                <textarea class="form-control" id="description" name="description" rows="3">{{policy.description}}</textarea>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="status" class="form-label fw-bold">Κατάσταση <req-star></req-star></label>
                                <select class="form-select" id="status" name="status" required>
                                    {{#each (labelEntries 'policyStatus')}}
                                    <option value="{{this.value}}" {{#if (eq this.value ../policy.status)}}selected{{/if}}>{{this.name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="effectiveDate" class="form-label fw-bold">Ημ. Έναρξης Ισχύος</label>
                                <input type="date" class="form-control" id="effectiveDate" name="effectiveDate" value="{{dateInput policy.effectiveDate}}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="reviewDate" class="form-label fw-bold">Ημ. Επισκόπησης</label>
                                <input type="date" class="form-control" id="reviewDate" name="reviewDate" value="{{dateInput policy.reviewDate}}">
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="d-flex g-2">
                                    <button type="submit" class="btn btn-success btn-icon">
                                        <bootstrap-icon icon="check-circle-fill"></bootstrap-icon>
                                        <div>{{#if (eq mode 'create')}}Δημιουργία{{else}}Αποθήκευση{{/if}}</div>
                                    </button>
                                    <a href="{{baseUrl}}" class="btn btn-secondary btn-icon">
                                        <bootstrap-icon icon="x-circle-fill"></bootstrap-icon>
                                        <div>Ακύρωση</div>
                                    </a>
                                    <bootstrap-spinner class="d-none"></bootstrap-spinner>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            {{#unless (eq mode 'create')}}
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="bi bi-paperclip me-2"></i>
                        Αρχεία
                    </h5>
                </div>
                <div class="card-body" x-data="fileManager('{{baseUrl}}/{{policy.id}}/storage')">

                    <div x-show="loading" class="text-center py-2">
                        <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                    </div>

                    <p x-show="!loading && !files.length" class="text-muted small mb-3">Δεν υπάρχουν ανεβασμένα αρχεία.</p>

                    <div x-show="!loading && files.length > 0" class="mb-3">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Αρχείο</th>
                                    <th class="text-end">Μέγεθος</th>
                                    <th class="text-end">Ανέβηκε</th>
                                    <th class="text-end">Ενέργειες</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="file in files" :key="file.name">
                                    <tr>
                                        <td class="align-middle">
                                            <i class="bi bi-file-earmark me-1 text-muted"></i>
                                            <span x-text="file.name"></span>
                                        </td>
                                        <td class="text-muted align-middle text-end"><sl-format-bytes :value="file.size"></sl-format-bytes></td>
                                        <td class="text-muted align-middle text-end" x-text="Q.date(file.createdAt)"></td>
                                        <td class="align-middle text-end" style="white-space:nowrap">
                                            <a :href="storageUrl + '/download?name=' + encodeURIComponent(file.name)" class="btn btn-sm btn-outline-primary btn-icon me-1">
                                                <i class="bi bi-download"></i>
                                                <span>Λήψη</span>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-icon" @click="deleteFile(file)">
                                                <i class="bi bi-trash"></i>
                                                <span>Διαγραφή</span>
                                            </button>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>

                    <form @submit.prevent="uploadFile">
                        <div class="d-flex g-2 align-items-end mt-4">
                            <div class="flex-grow-1">
                                <label class="form-label fw-bold small mb-1">Ανέβασμα νέου αρχείου</label>
                                <input type="file" class="form-control" x-ref="fileInput" :disabled="uploading" required>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm btn-icon" :disabled="uploading">
                                <i class="bi bi-upload"></i>
                                <span>Ανέβασμα</span>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
            {{/unless}}
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="ti-info me-2"></i>
                        Πληροφορίες
                    </h5>
                </div>
                <div class="card-body">
                    {{#unless (eq mode 'create')}}
                    <small class="text-muted">
                        <p><strong>Δημιουργία:</strong><br>{{date policy.createdAt}}</p>
                        <p><strong>Τελευταία ενημέρωση:</strong><br>{{date policy.updatedAt}}</p>
                        {{#if policy.policyType}}
                        <p><strong>Πρότυπο:</strong><br>{{policy.policyType.name}}</p>
                        {{/if}}
                    </small>
                    {{/unless}}
                    <a href="{{baseUrl}}" class="btn btn-secondary w-100 mt-2">
                        <i class="ti-arrow-left me-1"></i>
                        Επιστροφή στη Λίστα
                    </a>
                </div>
            </div>



            {{#if (and (eq mode 'edit') (can 'manage:any:content'))}}
            <div class="accordion mt-3 d-none d-xl-block" id="actionsAccordion">
                <div class="accordion-item card">
                    <h2 class="accordion-header card-header p-0" id="actionsHeading">
                        <button class="accordion-button accordion-card-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#actionsCollapse" aria-expanded="false" aria-controls="actionsCollapse">
                            Πρόσθετες ενέργειες
                        </button>
                    </h2>
                    <div id="actionsCollapse" class="accordion-collapse collapse" aria-labelledby="actionsHeading" data-bs-parent="#actionsAccordion">
                        <div class="accordion-body card-body">
                            <div class="d-grid g-2">
                                <button type="button" class="btn btn-danger btn-icon" id="btnDeletePolicy">
                                    <i class="bi bi-trash"></i>
                                    <span>Διαγραφή {{displayType.singularLower}}</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/if}}

        </div>
    </div>
</div>

<script>
function fileManager(storageUrl) {
    return {
        storageUrl,
        loading: true,
        files: [],
        uploading: false,

        async init() {
            await this.loadFiles();
        },

        async loadFiles() {
            this.loading = true;
            try {
                const res = await fetch(this.storageUrl + '/list');
                const data = await res.json();
                this.files = data.files ?? [];
            } catch {
                this.files = [];
            }
            this.loading = false;
        },

        async uploadFile() {
            if (this.uploading) return;
            this.uploading = true;
            const formData = new FormData();
            formData.append('file', this.$refs.fileInput.files[0]);
            try {
                const res = await fetch(this.storageUrl + '/upload', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    this.$refs.fileInput.value = '';
                    showSuccessModal(data.message, 2000);
                    await this.loadFiles();
                } else {
                    showErrorModal(data.message);
                }
            } catch {
                showErrorModal('Σφάλμα κατά το ανέβασμα.');
            }
            this.uploading = false;
        },

        async deleteFile(file) {
            const confirmed = await Q.confirm(`Θέλετε σίγουρα να διαγράψετε το αρχείο "${file.name}";`, 'Ναι, διαγραφή!', 'Ακύρωση');
            if (!confirmed) return;
            try {
                const res = await fetch(this.storageUrl + '/delete', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: file.name }),
                });
                const data = await res.json();
                if (data.success) {
                    showSuccessModal(data.message, 2000);
                    await this.loadFiles();
                } else {
                    showErrorModal(data.message);
                }
            } catch {
                showErrorModal('Σφάλμα κατά τη διαγραφή.');
            }
        },
    };
}
</script>

<script type="module">
const isCreate = {{#if (eq mode 'create')}}true{{else}}false{{/if}};
const baseUrl = '{{baseUrl}}';

document.addEventListener('DOMContentLoaded', function() {

    {{#if (eq mode 'create')}}
    /* Auto-fill πεδίων βάσει επιλεγμένου policy type */
    const policyTypes = {{{objectify availablePolicyTypes}}};
    const policyTypeMap = new Map(policyTypes.map(pt => [String(pt.id), pt]));

    Q('#policyTypeId').on('change', function() {
        const pt = policyTypeMap.get(this.value);
        if (pt) {
            Q('#code').value = pt.code ?? '';
            Q('#name').value = pt.name;
            Q('#description').value = pt.description ?? '';
        } else {
            Q('#code').value = '';
            Q('#name').value = '';
            Q('#description').value = '';
        }
    });
    {{/if}}

    /* Αυτόματη συμπλήρωση κωδικού από το όνομα, αν το code είναι κενό */
    Q('#name').on('change', function() {
        if (!Q('#code').value) {
            Q('#code').value = createCodeFromName(this.value);
        }
    });

    Q('#form').on('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        await submitData(
            data,
            baseUrl,
            isCreate ? 'POST' : 'PUT',
            isCreate ? baseUrl : null,
        );
    });

    async function deletePolicy() {
        const confirmationMessage = 'Θέλετε σίγουρα να διαγράψετε αυτή τη {{displayType.singularLower}};';
        const redirectPath = window.location.origin + baseUrl;
        await deleteEntity(confirmationMessage, redirectPath);
    }
    Q('#btnDeletePolicy').on('click', deletePolicy);

});
</script>
