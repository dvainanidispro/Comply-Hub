<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h1 class="card-title h3">
                        <i class="bi bi-people me-2"></i>
                        Συνεργάτες
                    </h1>
                    <div class="card-actions">
                        <a href="/organization/resources/partners/new" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>
                            Νέος Συνεργάτης
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table dim-table auto-rows table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th class="sortable">ID</th>
                                    <th class="sortable">Επωνυμία</th>
                                    <th class="sortable">Email</th>
                                    <th class="sortable">ΑΦΜ</th>
                                    <th class="sortable">Τηλέφωνο</th>
                                    <th class="sortable">Ενεργός</th>
                                    <th class="">Επεξεργασία</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each partners}}
                                <tr>
                                    <td>{{this.id}}</td>
                                    <td class="fw-semibold">{{this.profile.name}}</td>
                                    <td>{{this.profile.email}}</td>
                                    <td>{{this.profile.taxId}}</td>
                                    <td>{{this.profile.phone}}</td>
                                    <td>
                                        <span title="{{label 'activeBooleanMasculine' this.active }}">
                                            <i class="{{label 'activeIcon' this.active }}"></i>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/organization/resources/partners/{{this.id}}" class="btn btn-primary" title="Επεξεργασία">
                                            <i class="ti-eye text-white"></i>
                                        </a>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
