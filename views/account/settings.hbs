<div class="container-fluid">
    <div class="row">
        <!-- Breadcrumb -->
        <div class="col-12 mb-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard">Αρχική</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Ρυθμίσεις</li>
                </ol>
            </nav>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="bi bi-building me-2"></i>
                        Ενεργός Οργανισμός
                    </h4>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Επιλέξτε τον οργανισμό στον οποίο θα λειτουργείτε ως Υπεύθυνος σε αυτήν την συνεδρία.</p>

                    <div class="list-group mb-4">
                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-2 hand">
                            <input class="form-check-input" type="radio" name="orgSelection" value="">
                            <span class="text-muted">Κανένας Οργανισμός</span>
                        </label>
                        {{#each organizations}}
                        <label class="list-group-item  list-group-item-action d-flex align-items-center gap-2 hand">
                            <input class="form-check-input" type="radio" name="orgSelection" value="{{this.id}}">
                            <span class="fw-semibold">{{this.name}}</span>
                        </label>
                        {{/each}}
                    </div>

                    <div class="d-flex g-2">
                        <button id="btnSave" class="btn btn-success btn-icon">
                            <bootstrap-icon icon="check-circle-fill"></bootstrap-icon>
                            <div>Αποθήκευση</div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module">
    /* Επισήμανση του τρέχοντος οργανισμού από το cookie */
    const currentOrg = Q.cookies.get('org') || '';
    const currentRadio = document.querySelector(`input[name="orgSelection"][value="${currentOrg}"]`);
    if (currentRadio) currentRadio.checked = true;

    Q('#btnSave').on('click', function () {
        const selected = document.querySelector('input[name="orgSelection"]:checked');
        if (!selected) return;
        Q.cookies.set('org', selected.value);
        const redirect = Q.url.get('redirect');
        if (redirect) {
            window.location.href = redirect;
        } else {
            const orgName = selected.value ? selected.closest('label').querySelector('span').textContent : null;
            const message = orgName ? `Λειτουργείτε πλέον ως Υπεύθυνος του Οργανισμού "${orgName}".` : 'Επιλέξατε να μην λειτουργείτε ως Υπεύθυνος.';
            Q.alert(message, 'OK');
        }
    });
</script>
