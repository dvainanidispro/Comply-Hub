<div class="kpi-grid" x-data="{kpis: {{objectify kpis}} }">
    <template x-for="kpi in kpis" :key="kpi.code">
        <div class="card kpi-card" :class="`border-${kpi.status} bg-${kpi.status}-subtle`">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-light text-dark border small" x-text="kpi.period"></span>
                    <code class="small text-muted" x-text="kpi.code"></code>
                </div>
                <div class="mt-auto py-2 border-bottom">
                    <div class="fw-semibold text-center text-pretty" :title="kpi.template.name" x-text="kpi.template.name"></div>
                </div>
                <div class="text-center my-auto py-2">
                    <div class="display-5 fw-bold" :class="`text-${kpi.status}`" x-text="kpi.value != null ? kpi.value : '—'"></div>
                    <div class="text-muted" x-text="$store.unitLabel[kpi.template.unit] ?? ''"></div>
                </div>
                <div class="mt-auto pt-2 border-top text-end">
                    <div class="small text-muted">Στόχος: <strong x-text="kpi.template.successRule.criteria"></strong> <span x-text="$store.unitLabel[kpi.template.unit] ?? ''"></span></div>
                </div>
            </div>
        </div>
    </template>
</div>
