<div class="kpi-grid" x-data="{kpis: {{objectify kpis}}, links: {{links}}, section: '{{or section 'grid'}}' }">
    <template x-for="kpi in kpis" :key="`${kpi.period}:${kpi.code}`">
        <div class="card kpi-card bg-gradient-sharp" 
            :class="`border-${kpi.color} bg-${kpi.color}-subtle ${links?'hand':''}`" 
            {{!-- :data-code="kpi.code" :data-period="kpi.period" :data-id="kpi.id" :data-submitted="kpi.submitted" --}}
            @click="links && $dispatch('edit-kpi', { object: kpi })">

            <div class="card-body">
                <div class="kpi-card-header">
                    <span class="badge border small" x-text="kpi.period" :id="`kpi-period-${section}-${kpi.code}`"></span>
                    <wa-tooltip :for="`kpi-period-${section}-${kpi.code}`" x-text="periodDescription(kpi.period)"></wa-tooltip>
                    <code class="small text-muted" x-text="kpi.code"></code>
                </div>
                <div class="kpi-card-title border-bottom">
                    <div :title="kpi.template?.name" x-text="kpi.template?.name"></div>
                </div>
                <div class="kpi-card-value my-auto">
                    <div class="display-6 fw-bold" :class="`text-${kpi.color}`" x-text="number(kpi.value)"></div>
                    <div class="text-muted small" x-text="$store.unit[kpi.template?.unit] ?? ''"></div>
                </div>
                <div class="kpi-card-footer border-top">
                    <div class="small text-muted">Στόχος: <strong x-text="kpi.template?.successRule.criteria"></strong> <span x-text="$store.unit[kpi.template?.unit] ?? ''"></span></div>
                </div>
            </div>
        </div>
    </template>
</div>
