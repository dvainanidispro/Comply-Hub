<wa-dialog id="kpi-dialog"
    x-data="{
        currentKpi: {},
        async submitKpi() {
            const response = await fetch(window.location.href, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(this.currentKpi),
            });
            Q('#kpi-dialog').open = false;
            if (response.ok) {
                window.location.reload();
            } else {
                showErrorModal('Αποτυχία αποθήκευσης KPI. Παρακαλώ δοκιμάστε ξανά.');
            }
        },
    }"
    @edit-kpi.window="
        currentKpi = structuredClone(Alpine.raw($event.detail.object));
        {{!-- console.log('currentKpi:', currentKpi); --}}
        $el.open = true;
        "
    >

    <div slot="label">
        <h4 x-text="currentKpi.template?.name" class="text-balanced"></h4>
        <h5 x-text="periodDescription(currentKpi.period)" class="text-muted me-2"></h5>
        <hr class="my-1">
    </div>

    <form @submit.prevent="submitKpi()" class="p-1">
        <input type="hidden" x-model="currentKpi.id">
        <input type="hidden" x-model="currentKpi.code">
        <input type="hidden" x-model="currentKpi.period">

        <p x-text="currentKpi.template?.description" class="text-pretty"></p>
        <div class="row gap-2 ms-3 me-3 p-2">
            <div class="col mb-3">
                <label class="form-label fw-bold" x-text="`Τιμή - ${$store.unitLabel[currentKpi.template?.unit] ?? ''}`"></label>
                <input type="number" 
                    class="form-control form-control-lg" step="any"
                    x-model.number="currentKpi.value" 
                    :disabled="!currentKpi.applicable"
                    :min="Math.min(currentKpi.template?.thresholdWorst, currentKpi.template?.thresholdBest)"
                    :max="Math.max(currentKpi.template?.thresholdWorst, currentKpi.template?.thresholdBest)">
                <div class="form-text" x-text="`Στόχος: ${currentKpi.template?.successRule.criteria} ${$store.unit[currentKpi.template?.unit]}`"></div>
            </div>
            <div class="col text-center">
                <label class="form-label fw-bold">Κατάσταση</label>
                <div class="fw-bold" 
                    :class="`text-${kpiSuccessStatus(currentKpi).color}`" 
                    x-show="kpiSuccessStatus(currentKpi).value!=null"
                    x-text="(kpiSuccessStatus(currentKpi).value ? 'Επιτυχία' : 'Αποτυχία')"
                ></div>
                <div class="col text-center" x-show="kpiSuccessStatus(currentKpi).deviation">
                    Απόκλιση: <span class="fw-bold" 
                        {{!-- :class="`text-${kpiSuccessStatus(currentKpi).color}`"  --}}
                        x-text="kpiSuccessStatus(currentKpi)?.deviation?.toLocaleString() + ($store.unit[currentKpi.template?.unit])"
                    ></span>
                </div>
            </div>

        <div class="mb-3">
            <div class=" d-flex g-2 align-items-center">
                <input type="checkbox" id="kpi-not-applicable" class=""
                    :checked="!currentKpi.applicable"
                    @change="currentKpi.applicable = !$event.target.checked">
                <label for="kpi-not-applicable">
                    <div class="form-check-label mb-0" >Δεν εφαρμόζεται</div>
                    <div class="form-text mt-0">Ενεργοποιήστε αν δεν υπάρχουν δεδομένα ή το KPI δεν εφαρμόζεται</div>
                </label>
            </div>
            
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Σχόλια ή διορθωτικές ενέργειες</label>
            <textarea class="form-control" x-model="currentKpi.comments" rows="3"></textarea>
        </div>

        <div slot="footer" class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" @click="$el.closest('wa-dialog').open = false">Ακύρωση</button>
            <button type="submit" class="btn btn-primary" :disabled="(currentKpi.value==null)&&(currentKpi.applicable)">Αποθήκευση</button>
        </div>
    </form>

</wa-dialog>

