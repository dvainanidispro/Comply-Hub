<script>
window.policies = {{{objectify policies}}};
window.baseUrl = '{{baseUrl}}';
window.displayType = {{{objectify displayType}}};
const showID = false;
</script>

<div class="container-fluid" x-data="policiesApp()">

    <!-- Πίνακας πολιτικών -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h1 class="card-title h3">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        {{title}}
                    </h1>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped dim-table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th class="sortable" x-show="showID" style="width:7ch">ID</th>
                                    <th class="sortable" style="width:14ch">
                                        <wa-tooltip for="table-id">Προαιρετικό</wa-tooltip>
                                        <span id="table-id">Κωδικός</span>
                                    </th>
                                    <th class="sortable" style="width:60ch">Όνομα</th>
                                    <th>Περιγραφή</th>
                                    <th class="text-center sortable" style="width:18ch">
                                        <wa-tooltip for="table-default">
                                            Καθορίζει αν το πρότυπο θα συμπεριλαμβάνεται στη μαζική απόδοση σε Οργανισμό.
                                        </wa-tooltip>
                                            <span id="table-default">Προεπιλογή</span>
                                    </th>
                                    <th class="text-center sortable" data-sort-type="number" style="width:12ch">
                                        <wa-tooltip for="table-order">
                                            Προαιρετικό. Kαθορίζει τη σειρά εμφάνισης. Δεν έχει λειτουργική σημασία.</wa-tooltip>
                                        </wa-tooltip>
                                            <span id="table-order">Σειρά</span>
                                    </th>
                                    <th class="text-center sortable" style="width:12ch">Ενεργή</th>
                                    <th class="text-center" style="width:15ch">Αποθήκευση</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="row in rows" :key="row.id">
                                    <tr :class="!row.active ? 'table-secondary text-muted' : ''">
                                        <td x-show="showID" x-text="row.id"></td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                x-model="row.code"
                                                :class="{ 'is-invalid': row._codeInvalid }"
                                                @input="row._codeInvalid = false">
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                x-model="row.name"
                                                :class="{ 'is-invalid': row._nameInvalid }"
                                                @input.debounce="row._nameInvalid = false; if (!row.code) row.code = createCodeFromName(row.name)">
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                x-model="row.description">
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class=""
                                                :checked="row.default"
                                                @change="row.default = $event.target.checked">
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm"
                                                x-model="row.sequence" style="width:60px">
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class=""
                                                :checked="row.active"
                                                @change="row.active = $event.target.checked">
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-success btn-action me-1" title="Αποθήκευση"
                                                @click="saveRow(row)"
                                                :disabled="row._saving">
                                                <span x-show="!row._saving"><i class="bi bi-floppy"></i></span>
                                                <span x-show="row._saving"><i class="bi bi-hourglass-split"></i></span>
                                            </button>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Προσθήκη νέου policy type -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title h5 mb-0">
                        <i class="bi bi-plus-circle me-2"></i>
                        Προσθήκη νέου πρότυπου
                    </h2>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-around g-3 align-items-stretch">
                        <div class="full-column" style="width:12ch">
                            <label class="form-label small">Κωδικός</label>
                            <input type="text" class="form-control form-control-sm" x-model="newRow.code"
                                :class="{ 'is-invalid': newRow._codeInvalid }"
                                @input="newRow._codeInvalid = false">
                        </div>
                        <div class="full-column" style="min-width:50ch">
                            <label class="form-label small">Όνομα</label>
                            <input type="text" class="form-control form-control-sm" x-model="newRow.name"
                                :class="{ 'is-invalid': newRow._nameInvalid }"
                                @input.debounce="newRow._nameInvalid = false; if (!newRow.code) newRow.code = createCodeFromName(newRow.name)">
                        </div>
                        <div class="full-column" style="min-width:50ch">
                            <label class="form-label small">Περιγραφή</label>
                            <input type="text" class="form-control form-control-sm" x-model="newRow.description">
                        </div>
                        <div class="full-column text-center center-content" style="width:14ch; padding-bottom:8px">
                            <label class="form-label small">Προεπιλογή</label>
                            <input type="checkbox" class="" x-model="newRow.default">
                        </div>
                        <div class="full-column" style="width:8ch">
                            <label class="form-label small">Σειρά</label>
                            <input type="number" class="form-control form-control-sm" x-model="newRow.sequence">
                        </div>
                        <div class="row align-self-end" style="width:12ch">
                            <div class="center-content">
                                <button class="btn btn-primary btn-action" @click="createRow()" :disabled="newRow._saving">
                                    <span x-show="!newRow._saving"><i class="bi bi-plus-circle"></i></span>
                                    <span x-show="newRow._saving"><i class="bi bi-hourglass-split"></i></span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2 text-danger small" x-show="newRow._error" x-text="newRow._error"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>

    window.dimtablesOptions = {
        showTopBar: false,
    };

    function policiesApp() {
        let baseUrl = window.baseUrl;

        return {
            rows: window.policies.map(p => ({ ...p, _saving: false, _codeInvalid: false, _nameInvalid: false })),
            newRow: { sequence: '', code: '', name: '', description: '', default: false, active: true, _saving: false, _error: '', _nameInvalid: false, _codeInvalid: false },

            async saveRow(row) {
                if (!row.code?.trim()) row._codeInvalid = true;
                if (!row.name?.trim()) row._nameInvalid = true;
                if (row._codeInvalid || row._nameInvalid) return;
                row._saving = true;
                try {
                    const res = await fetch(`${baseUrl}/${row.id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            code: row.code,
                            name: row.name,
                            description: row.description,
                            sequence: row.sequence !== '' ? row.sequence : null,
                            default: row.default,
                            active: row.active,
                        }),
                    });
                    const data = await res.json();
                    if (data.ok) {
                        window.location.reload();
                    } else {
                        row._saving = false;
                        alert(data.message || 'Σφάλμα κατά την αποθήκευση.');
                    }
                } catch (e) {
                    row._saving = false;
                    alert('Σφάλμα δικτύου.');
                }
            },

            async createRow() {
                if (!this.newRow.code?.trim()) this.newRow._codeInvalid = true;
                if (!this.newRow.name.trim()) this.newRow._nameInvalid = true;
                if (this.newRow._codeInvalid || this.newRow._nameInvalid) return;
                this.newRow._saving = true;
                this.newRow._error = '';
                try {
                    const res = await fetch(baseUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            code: this.newRow.code,
                            name: this.newRow.name,
                            description: this.newRow.description,
                            sequence: this.newRow.sequence !== '' ? this.newRow.sequence : null,
                            default: this.newRow.default,
                            active: true,
                        }),
                    });
                    const data = await res.json();
                    if (data.ok) {
                        window.location.reload();
                    } else {
                        this.newRow._saving = false;
                        this.newRow._error = data.message || 'Σφάλμα κατά την προσθήκη.';
                    }
                } catch (e) {
                    this.newRow._saving = false;
                    this.newRow._error = 'Σφάλμα δικτύου.';
                }
            },
        };
    }
</script>

<script type="module">
    /* Έλεγχος για διπλότυπους κωδικούς */
    const codeCount = new Map();
    for (const p of window.policies) {
        if (!p.code) continue;
        codeCount.set(p.code, (codeCount.get(p.code) ?? 0) + 1);
    }
    for (const [code, count] of codeCount) {
        if (count > 1) Q.alert(`Υπάρχουν ${count} ${window.displayType.pluralLower} με τον ίδιο κωδικό: ${code}`, 'OK');
    }
</script>

<style>
    :root {
        --wa-tooltip-background-color: hsl(242, 36%, 42%);
    }
</style>
