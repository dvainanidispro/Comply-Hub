<div class="container-fluid">
    <div class="row">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header">
                    <h1 class="card-title h3">
                        <i class="bi bi-clipboard-check me-2"></i>
                        {{framework}} - {{questionnaire.title}}
                    </h1>
                </div>
                <div class="card-body">
                    <form id="form" 
                        x-data="{
                            content: null, answers: null, actions: null,
                            get valid() {
                                return {
                                    content: isValidJSON(this.content),
                                    answers: isValidJSON(this.answers),
                                    actions: isValidJSON(this.actions),
                                    get form() { return this.content && this.answers && this.actions },
                                    get answerSet() { return window.validateAnswerSet($refs.content.value, $refs.answers.value); },
                                };
                            }
                        }" 
                        x-init="content = $refs.content.value; answers = $refs.answers.value; actions = $refs.actions.value"
                    >
                        <input type="hidden" readonly name="id" value="{{questionnaire.id}}">

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label for="title" class="form-label fw-bold">Τίτλος <req-star></req-star></label>
                                <input type="text" class="form-control" id="title" name="title" value="{{questionnaire.title}}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="code" class="form-label fw-bold">Κωδικός</label>
                                <input type="text" class="form-control" id="code" value="{{code}}" disabled>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label for="public" class="form-label fw-bold">Δημόσιο</label>
                                <select class="form-select" id="public" name="public">
                                     <option value="false" {{#unless questionnaire.public}}selected{{/unless}}>{{label 'questionnaire' 'publicFalse'}}</option>
                                     <option value="true" {{#if questionnaire.public}}selected{{/if}}>{{label 'questionnaire' 'publicTrue'}}</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="active" class="form-label fw-bold">Ενεργό</label>
                                <select class="form-select" id="active" name="active">
                                    <option value="true" {{#if questionnaire.active}}selected{{/if}}>Ναι</option>
                                    <option value="false" {{#unless questionnaire.active}}selected{{/unless}}>Όχι</option>
                                </select>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="description" class="form-label fw-bold">Περιγραφή και οδηγίες</label>
                                <textarea class="form-control" id="description" name="description" rows="3">{{questionnaire.definition.description}}</textarea>
                            </div>

                            <!-- JSON FIELDS -->
                            <div class="col-md-12 mb-3">
                                <label for="content" class="form-label fw-bold">Περιεχόμενο - Ενότητες και Ερωτήσεις (JSON)</label>
                                <textarea class="form-control json" id="content" name="content" x-ref="content" rows="30" @input="content = $el.value" :class="valid.content?'is-valid':'is-invalid'">{{objectify questionnaire.content}}</textarea>
                                <div>
                                    <span class="invalid-feedback">Μη έγκυρο JSON.</span>
                                    <span x-cloak x-show="invalidSequencesOf(content).length" class="text-danger">Μη έγκυροι χαρακτήρες: <span x-text="invalidSequencesOf(content)"></span></span>
                                </div>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="answers" class="form-label fw-bold">Σετ Απαντήσεων (JSON)</label>
                                <textarea class="form-control json" id="answers" name="answers" x-ref="answers" rows="20" @input="answers = $el.value" :class="valid.answers?'is-valid':'is-invalid'">{{objectify questionnaire.answers}}</textarea>
                                <div>
                                    <span class="invalid-feedback">Μη έγκυρο JSON.</span>
                                    <span x-cloak x-show="invalidSequencesOf(answers).length" class="text-danger">Μη έγκυροι χαρακτήρες: <span x-text="invalidSequencesOf(answers)"></span></span>
                                </div>
                                <div class="text-warning" x-show="!valid.answerSet" >🟠 Υπάρχουν ερωτήσεις του ερωτηματολόγιου χωρίς απαντήσεις!</div>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="actions" class="form-label fw-bold">Ενέργειες (JSON)</label>
                                <textarea class="form-control json" id="actions" name="actions" x-ref="actions" rows="6" 
                                    @input="actions = $el.value" :class="valid.actions?'is-valid':'is-invalid'"
                                    placeholder="(Αφήστε κενό για τα default κουμπιά)"
                                    >
                                        {{check questionnaire.definition.actions (objectify questionnaire.definition.actions) ''}}
                                </textarea>
                                <div>
                                    <span class="invalid-feedback">Μη έγκυρο JSON.</span>
                                    <span x-cloak x-show="invalidSequencesOf(actions).length" class="text-danger">Μη έγκυροι χαρακτήρες: <span x-text="invalidSequencesOf(actions)"></span></span>
                                </div>
                            </div>
                            <!-- ΤΕΛΟΣ JSON FIELDS -->
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="d-flex g-2">
                                    <button type="submit" class="btn btn-success btn-icon" :disabled="!valid.form">
                                        <bootstrap-icon icon="check-circle-fill"></bootstrap-icon>
                                        <div>Αποθήκευση</div>
                                    </button>
                                    {{#if (and questionnaire.definition questionnaire.answers)}}
                                    <a class="btn btn-info btn-icon" href="{{baseUrl}}/preview" target="_blank">
                                        <i class="bi bi-eye-fill"></i>
                                        <div>Προεπισκόπηση αποθηκευμένου</div>
                                    </a>
                                    {{/if}}
                                    <bootstrap-spinner class="d-none"></bootstrap-spinner>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module">
const baseUrl = '{{baseUrl}}';

document.addEventListener('DOMContentLoaded', function() {
    Q('#form').on('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        await submitData(data, baseUrl, 'POST');
    });
});
</script>
